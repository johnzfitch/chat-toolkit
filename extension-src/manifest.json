{
  "manifest_version": 2,
  "name": "Chat Toolkit",
  "version": "1.7.0",
  "description": "Export AI conversations to JSON, Markdown, or HTML, with supplied reasoning, sources, tool results, and optional diagnostics.",
  "author": "Zack Fitch <zack@definitelynot.ai>",

  "permissions": [
    "clipboardWrite",
    "downloads",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://grok.com/*",
    "https://openrouter.ai/*"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "chat-toolkit@definitelynot.ai",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent"]
      }
    }
  },

  "background": {
    "scripts": ["lib/background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://openrouter.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*"
      ],
      "js": [
        "lib/common.js",
        "lib/ui-model.js",
        "lib/dom-helpers.js",
        "lib/api-fetchers.js",
        "lib/parser-worker.js",
        "lib/page-bridge.js",
        "lib/ui-panel.js",
        "lib/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "browser_action": {
    "default_icon": {
      "16": "icons/chat-toolkit-16.png",
      "32": "icons/chat-toolkit-32.png",
      "64": "icons/chat-toolkit-64.png"
    },
    "theme_icons": [
      { "size": 16, "light": "icons/toolbar/ink-light-16.png", "dark": "icons/toolbar/ink-dark-16.png" },
      { "size": 32, "light": "icons/toolbar/ink-light-32.png", "dark": "icons/toolbar/ink-dark-32.png" },
      { "size": 64, "light": "icons/toolbar/ink-light-64.png", "dark": "icons/toolbar/ink-dark-64.png" }
    ],
    "default_title": "Chat Toolkit",
    "default_popup": "popup/popup.html"
  },

  "options_ui": {
    "page": "help/privacy.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/chat-toolkit-16.png",
    "32": "icons/chat-toolkit-32.png",
    "48": "icons/chat-toolkit-48.png",
    "64": "icons/chat-toolkit-64.png",
    "96": "icons/chat-toolkit-96.png",
    "128": "icons/chat-toolkit-128.png"
  }
}
